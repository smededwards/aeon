<?xml version="1.0"?>
<ruleset name="Aeon">
	<description>WordPress coding standards for Aeon.</description>
	<file>.</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress"/>
	<config name="minimum_supported_wp_version" value="6.8"/>
	<!-- Keep the existing SettingsPage class name with a word-separated filename. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/admin/class-settings-page.php</exclude-pattern>
	</rule>
</ruleset>
