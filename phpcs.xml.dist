<?xml version="1.0"?>
<ruleset name="Aeon">
	<description>WordPress coding standards for Aeon.</description>
	<file>.</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress"/>
	<config name="minimum_supported_wp_version" value="6.8"/>
	<!-- Keep the existing SettingsPage class name with a word-separated filename. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/admin/class-settings-page.php</exclude-pattern>
		<!-- Use the preferred hyphenated WordPress filename for DashboardColour. -->
		<exclude-pattern>*/admin/class-dashboard-colour.php</exclude-pattern>
	</rule>

	<!-- This adapter returns only the tested, immutable sanitised submission. -->
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<properties>
			<property name="customSanitizingFunctions" type="array">
				<element value="aeon_sanitise_contact_submission"/>
			</property>
		</properties>
	</rule>
</ruleset>
